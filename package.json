{
  "name": "devdigital-dsk-sdk",
  "version": "0.2.0",
  "description": "Unofficial TypeScript SDK for DSK Bank's VPOS e-commerce payment gateway (redirect flow)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevDigital-Ltd/devdigital-dsk-sdk"
  },
  "keywords": [
    "dsk",
    "dsk-bank",
    "vpos",
    "payment-gateway",
    "bulgaria",
    "ecommerce",
    "payments"
  ],
  "author": "DevDigital Ltd <hi@devdigital.bg>",
  "homepage": "https://github.com/DevDigital-Ltd/devdigital-dsk-sdk#readme",
  "bugs": "https://github.com/DevDigital-Ltd/devdigital-dsk-sdk/issues",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^16.4.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
